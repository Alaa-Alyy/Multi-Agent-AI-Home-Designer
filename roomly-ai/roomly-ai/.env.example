# Roomly AI Environment Configuration

# Server Port
PORT=3000

# OpenAI API Key (Used for Vision Analysis, DALL-E 3 Image Generation, and Design Synthesis)
# Set your OpenAI API key below:
OPENAI_API_KEY=

# Product Search Provider API Keys (Optional - search agent is credential-ready)
# SerpAPI (Google Shopping Search): https://serpapi.com/
SERPAPI_API_KEY=

# Rainforest API (Amazon Product Search): https://www.rainforestapi.com/
RAINFOREST_API_KEY=

# RapidAPI Key (Retail Search APIs): https://rapidapi.com/
RAPIDAPI_KEY=

# Storage Directory for Sessions & Uploads
STORAGE_DIR=./data
