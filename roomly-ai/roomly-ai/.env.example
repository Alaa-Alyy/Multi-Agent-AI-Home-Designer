# Roomly AI configuration. Copy this file to .env and fill in the values. Never commit .env.

PORT=3000

# Cloudflare Workers AI (free plan: 10,000 neurons a day)
# Used for RAG embeddings, and as the backup for chat, room analysis and the room image.
# dash.cloudflare.com: Account ID is on the dashboard home; API token: My Profile > API Tokens > "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# SerpAPI (free plan: 250 searches a month) for Amazon.eg products. Optional:
# without it, Roomly searches IKEA Egypt only.  https://serpapi.com/
SERPAPI_API_KEY=

# Free providers used first, with Cloudflare as backup (or the other way round, see the AI_*_ORDER lines)
# Groq: chat and room-photo analysis, ~1,000 requests a day.  console.groq.com > API Keys
GROQ_API_KEY=
# Hugging Face: furnishes the room photo on the public FLUX.2 klein Space (a few GPU minutes a day).
# huggingface.co > Settings > Access Tokens. Also tick "Make calls to Inference Providers" for RAG embeddings.
HF_TOKEN=

# Optional: change the order providers are tried in (comma-separated)
# AI_CHAT_ORDER=groq,cloudflare
# AI_VISION_ORDER=groq,cloudflare
# AI_IMAGE_ORDER=huggingface,cloudflare
# AI_EMBED_ORDER=cloudflare,huggingface

# Where sessions, uploads, generated images and the search cache are stored
STORAGE_DIR=./data
